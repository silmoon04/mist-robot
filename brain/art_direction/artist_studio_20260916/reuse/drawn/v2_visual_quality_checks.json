  "measurements_only": true,
  "review_notes_for_v2_sources": [
    {
      "asset": "round",
      "finding": "The new near-closed gap and low reopening pose improve the progression. Adjacent width changes are smaller. Rest and settled contours differ more than v1; use rest again to close the loop if the seam is noticeable."
    },
    {
      "asset": "loop",
      "finding": "The reopening pose is connected instead of splitting into two arcs. The crossbar disappears through closure and returns as the eye opens. Rest and settled contours have the largest loop seam difference among the new eye sets."
    },
    {
      "asset": "arc",
      "finding": "The closure now flattens the arch without reversing its curvature. Width stays nearly constant, making this a clearer squeeze."
    },
    {
      "asset": "hook",
      "finding": "Closing and reopening now have narrow-gap intermediate poses. Width remains stable."
    },
    {
      "asset": "chevron",
      "finding": "The angle narrows through closing instead of shrinking the whole glyph. This better preserves the eye identity."
    },
    {
      "asset": "mouth_neutral",
      "finding": "Release, small AA, wide close, and round close provide useful intermediate silhouettes. FV and LNT are still visually similar symbolic notches; do not describe them as anatomically accurate lip shapes."
    },
    {
      "asset": "mouth_smile",
      "finding": "The smile set keeps slightly raised corners in some poses, but much of its speech still resembles the neutral set. This is a reusable symbolic mouth library rather than detailed human lip sync."
    }
  ],
  "review_notes_for_v1_sources": [
    {
      "asset": "round",
      "finding": "Opening cel 4 is much narrower than the settled eye. Closing cel 2 is already a closed arc, leaving no near-closed gap breakdown."
    },
    {
      "asset": "loop",
      "finding": "Opening cel 4 splits into two arcs and drops the crossbar. This changes the loop identity before the settled cel restores it."
    },
    {
      "asset": "hook",
      "finding": "The gradual closing sequence is clearer than round and loop. Reopening jumps from the closed stroke to a large gap in one cel."
    },
    {
      "asset": "arc",
      "finding": "The closure changes curvature and is visible. Lowering and reopening cels remain broad arches, so the final curvature flip is abrupt."
    },
    {
      "asset": "slot",
      "finding": "Closing and opening preserve the narrow slot. The closed arc is a deliberate shape change; the generated settled slot is slightly skewed versus the horizontal rest."
    },
    {
      "asset": "chevron",
      "finding": "Lowering mostly shrinks the chevron before an abrupt switch to an arc. A bent narrow-chevron breakdown would make the action read better."
    },
    {
      "asset": "bar",
      "finding": "The pinch bends an already closed bar and becomes narrower. It is visible motion, not an eyelid covering an aperture."
    },
    {
      "asset": "mouth_neutral",
      "finding": "Core silhouettes are usable, but AA, EH, EE and rounded lips need transitional drawings to avoid popping. FV and LNT are symbolic poses, not anatomically differentiated lips."
    },
    {
      "asset": "mouth_smile",
      "finding": "Rest and SMILE are visibly cheerful, but most speaking silhouettes closely match the neutral set. Expression-specific mouth character is weak during speech."
    },
    {
      "asset": "runtime_v1",
      "finding": "At 8 fps, 30 ms anticipation and 50 ms lowering can both be skipped. Holding closure alone prevents a missed blink but does not prevent a rest-to-closed jump."
    },
    {
      "asset": "runtime_v1",
      "finding": "Speech phase ends by switching generated mouths at fixed position 50,46.5 back to each original expression mouth without a transition. This can visibly pop for unlike source mouths."
    }
  ],
  "limits": [
    "No source pixels are changed.",
    "Silhouette IoU measures shape difference, not perceived quality. Large changes can be intentional.",
    "Human visual notes refer to the first-generation sheets and must not be treated as review of later replacements."
  ]
}
