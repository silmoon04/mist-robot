  <joint name="RR_wheel_drive" type="continuous">
    <parent link="RR_tibia" />
    <child link="RR_wheel" />
    <origin xyz="0 0 -0.14" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0" friction="0" />
  </joint>
</robot>